#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled config_path

	config_load mbed-agent
	config_get_bool enabled main enabled 1
	config_get config_path main config_path /etc/mbed-agent/config.toml
	[ "$enabled" -eq 1 ] || return 0

	mkdir -p /tmp/mbed-agent
	chmod 0700 /tmp/mbed-agent

	procd_open_instance
	procd_set_param command /usr/sbin/mbed-agentd --config "$config_path"
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="0" nofile="128"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mbed-agent
}

reload_service() {
	stop
	start
}

